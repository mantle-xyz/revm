# RPC URL - need support debug_getRawTransaction
# Mantle Mainnet example
MANTLE_URL=https://mantle-mainnet-rpc4.s7.gomantle.org
CHAIN_ID=5000


# Block range to process
START_BLOCK=88550000
END_BLOCK=88550010

# OP Stack specification version
# Valid values: Bedrock, Regolith, Canyon, Ecotone, Fjord, Granite, Holocene, Isthmus(default), Jovian, Interop, Osaka
OP_SPEC=Isthmus

# Enable state verification using eth_getProof
# Set to "true" to verify account balances, nonces, and storage slots against on-chain data
# Set to "false" to skip verification (faster execution)
# Default: false
STATE_VERIFY=false
